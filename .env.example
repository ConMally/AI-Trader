# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored — never commit real credentials.
#
# Phase 0 needs only the Supabase section below to run migrations and boot
# the app. Every other section belongs to a later phase and is called out
# accordingly — leave those blank until that phase is actually reached.

# -----------------------------------------------------------------------------
# Supabase (Phase 0+) — Project Settings -> API in your Supabase dashboard.
# The two NEXT_PUBLIC_* values are safe to expose to the browser: the anon
# key only grants what Row Level Security policies allow. The service role
# key is NOT safe to expose — it bypasses RLS entirely. Never prefix it with
# NEXT_PUBLIC_, never use it from client code; it exists only for the
# scheduled Edge Functions and admin scripts introduced from Phase 1 on.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Anthropic (Phase 5+ only) — powers the AI rationale layer that explains an
# already-sized, already-risk-checked proposal. Not read by anything before
# Phase 5; leave blank until then.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Alpaca — PAPER trading (Phase 1+). Get these from
# https://app.alpaca.markets/paper/dashboard/overview
# This is the only broker connection used through Phase 6. Paper is always
# the default account mode — nothing in this app reads the LIVE variables
# below unless an account has been explicitly switched to live mode via the
# Phase 7 opt-in flow.
# -----------------------------------------------------------------------------
ALPACA_PAPER_API_KEY_ID=
ALPACA_PAPER_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------------------------
# Alpaca — LIVE trading (Phase 7 opt-in ONLY — do not set until then).
# Deliberately a fully separate key namespace and base URL from PAPER above,
# with its own adapter implementation (see lib/broker/README.md). The app
# must never fall back from live to paper or paper to live automatically —
# if these are unset, live mode simply isn't available, by design.
# -----------------------------------------------------------------------------
ALPACA_LIVE_API_KEY_ID=
ALPACA_LIVE_API_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
