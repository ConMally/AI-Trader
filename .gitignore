# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — every .env variant is ignored except the checked-in
# template; this is deliberately broader than ".env / .env*.local" so a
# stray .env.development, .env.production, etc. can never be committed by
# accident. All Supabase, Anthropic, and Alpaca (paper AND live) secrets
# live in one of these ignored files, never in .env.example.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
